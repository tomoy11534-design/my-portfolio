# このファイルを .env という名前でコピーし、各キーを設定してください（.env は Git 管理外）

# Claude API キー（必須：練習・本番・振り返りの AI 機能）
ANTHROPIC_API_KEY=

# Deepgram API キー（ヘッドホン・イヤホン使用時に、面接官の声を文字起こしするのに必要）
DEEPGRAM_API_KEY=

# --- 以下は任意 ---
# 本番モード（速度重視）と、練習・振り返り（精度重視）で使う Claude のモデル
# CLAUDE_MODEL_LIVE=claude-opus-5
# CLAUDE_MODEL_DEEP=claude-opus-5
# 安全分類器で断られたときに別モデルで再実行するサーバー側フォールバック（off で無効）
# CLAUDE_FALLBACKS=on
# Deepgram の認識モデル
# DEEPGRAM_MODEL=nova-2
# 待ち受けポート
# PORT=5173
